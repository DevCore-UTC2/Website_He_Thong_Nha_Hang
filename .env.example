# ============================================================
# .env.example — Vị Nhà Mình
# Copy file này thành .env rồi điền giá trị thật.
# KHÔNG commit file .env vào git.
# ============================================================

# ——— Server ———
PORT=5000
NODE_ENV=development

# ——— Bảo mật ———
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-it-nhat-32-ky-tu
JWT_EXPIRES_IN=7d

# ——— Nhà hàng ———
RESTAURANT_DISPLAY_NAME=Vị Nhà Mình
RESTAURANT_TAGLINE=Ẩm thực miền Tây & Nam Bộ
RESTAURANT_ADDRESS=450 Lê Văn Việt, Phường Tăng Nhơn Phú, TP. Thủ Đức, TP. Hồ Chí Minh
OPEN_HOUR=9
CLOSE_HOUR=22
LAST_RESERVATION_HOUR=21

# ——— Người bán (hóa đơn) ———
# Đặt IS_DEMO_SELLER=true để dùng thông tin DEMO (mặc định)
# Đặt IS_DEMO_SELLER=false và điền các trường bên dưới khi phát hành thật
IS_DEMO_SELLER=true

# Khi IS_DEMO_SELLER=false, bắt buộc điền:
SELLER_DISPLAY_NAME=Vị Nhà Mình
SELLER_INVOICE_NAME=NHÀ HÀNG VỊ NHÀ MÌNH
SELLER_TAX_ID=          # MST 10 số thật — [CẦN ĐIỀN]
SELLER_ADDRESS=450 Lê Văn Việt, Phường Tăng Nhơn Phú, TP. Thủ Đức, TP. Hồ Chí Minh
SELLER_PHONE=           # SĐT thật — [CẦN ĐIỀN]
SELLER_EMAIL=           # Email thật — [CẢN ĐIỀN]
SELLER_BANK_ACCOUNT=    # Số tài khoản — [CẦN ĐIỀN]
SELLER_BANK_NAME=       # Tên ngân hàng — [CẦN ĐIỀN]

# ——— Hóa đơn — [CẦN XÁC NHẬN VỚI KẾ TOÁN] ———
INVOICE_TEMPLATE=1
INVOICE_SERIAL=C26MDM

# ——— Nhà cung cấp hóa đơn điện tử ———
# Để trống = bản DEMO, không kết nối cơ quan thuế
# Khi có: EINVOICE_PROVIDER=vnpt | viettel | misa
EINVOICE_PROVIDER=

# ——— Google OAuth (tùy chọn — Phase 3) ———
# Tạo tại: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=       # [CẦN ĐIỀN nếu dùng đăng nhập Google]
GOOGLE_CLIENT_SECRET=   # [CẦN ĐIỀN nếu dùng đăng nhập Google]

# ——— Demo mode ———
# Hiện nút đăng nhập nhanh (admin/staff/khách) trong giao diện
DEMO_MODE=true
